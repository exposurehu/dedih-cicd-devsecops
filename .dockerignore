# The build context is the set of files that docker build hands to the build
# engine. This file says what must stay out of it.

# Version control, which also contains the full commit history
.git
.gitignore
.gitleaksignore

# Secrets and local configuration
.env
.env.*
*.pem
*.key

# Python runtime and cache files
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Tests and the development environment: not needed in the image
tests/
.devcontainer/
.github/
.vscode/

# Documentation and the Dockerfile itself
README.md
docs/
docker/

# Operating system files
.DS_Store
